rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Demandes de pièces : lecture publique (nécessaire pour que les
    // magasins les voient sans compte dédié par demande), création libre
    // (clients anonymes), mise à jour limitée au champ "statut" (fermer
    // sa propre demande).
    match /part_requests/{requestId} {
      allow read: if true;
      allow create: if request.resource.data.statut == 'open';
      allow update: if request.resource.data.diff(resource.data)
                        .affectedKeys().hasOnly(['statut']);
      allow delete: if false;

      // Réponses des magasins : seul un magasin authentifié ET actif
      // peut répondre, et uniquement avec son propre uid comme id de
      // document (empêche d'écraser la réponse d'un concurrent).
      match /offers/{offerId} {
        allow read: if true;
        allow create, update: if request.auth != null
                                && request.auth.uid == offerId
                                && get(/databases/$(database)/documents/stores/$(request.auth.uid)).data.actif == true;
        allow delete: if false;
      }
    }

    // Comptes magasins : un magasin ne voit/modifie que son propre
    // profil, et ne peut jamais s'auto-activer (le champ "actif" ne
    // peut pas changer via une requête client — validation manuelle
    // uniquement, depuis la console Firebase).
    match /stores/{storeId} {
      allow create: if request.auth != null
                      && request.auth.uid == storeId
                      && request.resource.data.actif == false;
      allow read: if request.auth != null && request.auth.uid == storeId;
      allow update: if request.auth != null
                      && request.auth.uid == storeId
                      && request.resource.data.actif == resource.data.actif;
      allow delete: if false;
    }
  }
}
